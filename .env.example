# ─── Core ────────────────────────────────────────────────────────────────────
# Local dev needs none of this. Everything below is for making it a real,
# deployed, private service.

# Public URL of the app. OAuth redirects are built from it, so it must match
# exactly what you registered with each provider.
APP_URL=http://localhost:3000

# Your passcode. Set this before deploying — without it the app is open to
# anyone with the URL. Any long random string works.
AUTH_SECRET=

# Encrypts OAuth tokens at rest with AES-256-GCM. Set it BEFORE connecting any
# account: tokens saved without it are stored in plain text.
ENCRYPTION_KEY=

# Used to identify you and as the owner account's email.
OWNER_EMAIL=you@example.com

# Protects /api/cron. On Vercel, set this and Vercel Cron sends it automatically.
CRON_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
# Local: a SQLite file, created for you. Nothing to configure.
DATABASE_URL=file:./data/marketinghq.db

# Production: a Turso database (same SQLite, hosted, generous free tier).
#   brew install tursodatabase/tap/turso && turso db create marketinghq
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# ─── Claude ──────────────────────────────────────────────────────────────────
# Turns on the brain, the report drafter and the written daily brief. Everything
# else works without it. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Bearer token for the MCP endpoint, so Claude Desktop / Claude Code can query
# this brain. Falls back to AUTH_SECRET if unset.
MCP_TOKEN=

# ─── Google: Gmail, Calendar, GA4, Google Ads ───────────────────────────────
# One OAuth client covers all four. See SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads additionally needs a developer token from your MCC account.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ─── Microsoft: Outlook mail and calendar ───────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ─── Meta Ads ────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# ─── LinkedIn Ads ────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
